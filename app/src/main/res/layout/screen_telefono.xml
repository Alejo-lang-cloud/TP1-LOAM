<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">

        <!-- HEADER DE TELÉFONOS DE EMERGENCIA -->

        <TextView
            android:id="@+id/tv_emergency_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="Teléfonos de Emergencia"
            android:textColor="#C62828"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_emergency_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presiona un servicio para realizar la llamada rápida de auxilio"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_emergency_title"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- FILA 1: BOMBEROS (Rojo) y POLICÍA (Azul) -->

        <!-- 1. TARJETA BOMBEROS (100) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bomberos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#D32F2F"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_emergency_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_policia">

            <LinearLayout
                android:id="@+id/btn_bomberos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_fire"
                    android:contentDescription="Bomberos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BOMBEROS"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_num_bomberos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N° 100"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#FFCDD2"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca para llamar (113)"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. TARJETA POLICÍA (101) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_policia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#1976D2"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_emergency_subtitle"
            app:layout_constraintStart_toEndOf="@id/card_bomberos"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/btn_policia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_police"
                    android:contentDescription="Policía" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POLICÍA"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_num_policia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N° 101"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#BBDEFB"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca para llamar (113)"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FILA 2: DEFENSA CIVIL (Naranja) y SEM (Verde) -->

        <!-- 3. TARJETA DEFENSA CIVIL (103) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_defensa_civil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#E65100"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/card_bomberos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_sem">

            <LinearLayout
                android:id="@+id/btn_defensa_civil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_defense"
                    android:contentDescription="Defensa Civil" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEFENSA CIVIL"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_num_defensa_civil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N° 103"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#FFE0B2"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca para llamar (113)"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. TARJETA SEM (107) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#2E7D32"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/card_policia"
            app:layout_constraintStart_toEndOf="@id/card_defensa_civil"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/btn_sem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_sem"
                    android:contentDescription="SEM Salud" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEM (SALUD)"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_num_sem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N° 107"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#C8E6C9"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca para llamar (113)"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
