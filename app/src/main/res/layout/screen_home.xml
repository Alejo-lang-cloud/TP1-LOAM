<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">

        <!-- HEADER DE LA APLICACIÓN -->
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alerta Catástrofes"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistema de Monitoreo de Emergencia"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_header_title"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 1. CONTENEDOR DE CLIMA (Requerimiento C) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_clima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_header_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_clima_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clima Actual"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="#222222"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/iv_clima_icono"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    tools:src="@android:drawable/ic_menu_report_image"
                    app:layout_constraintTop_toBottomOf="@id/tv_clima_titulo"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_clima_temperatura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22°C"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginStart="20dp"
                    app:layout_constraintTop_toTopOf="@id/iv_clima_icono"
                    app:layout_constraintBottom_toBottomOf="@id/iv_clima_icono"
                    app:layout_constraintStart_toEndOf="@id/iv_clima_icono" />

                <TextView
                    android:id="@+id/tv_clima_descripcion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Despejado - Sin alertas meteorológicas vigentes"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    app:layout_constraintTop_toBottomOf="@id/iv_clima_icono"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_clima_ubicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Santa Rosa, La Pampa"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="#999999"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_clima_descripcion"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. CONTENEDOR DE MAPA (Requerimiento C - ¿Dónde estoy?) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/card_clima"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_mapa_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación Actual (GPS)"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="#222222"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Placeholder visual para el mapa de Google Maps -->
                <FrameLayout
                    android:id="@+id/fl_mapa_preview"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    android:background="#DDDDDD"
                    app:layout_constraintTop_toBottomOf="@id/tv_mapa_titulo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Vista Previa de Google Maps"
                        android:textSize="14sp"
                        android:textColor="#777777" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mapa_ver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:textSize="15sp"
                    android:layout_marginTop="12dp"
                    android:text="Abrir Mapa y Registrar Ubicación"
                    app:icon="@android:drawable/ic_menu_mylocation"
                    app:layout_constraintTop_toBottomOf="@id/fl_mapa_preview"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN DE ACCESOS RÁPIDOS (Fila 1: Información y Cámara) -->

        <!-- Tarjeta de Información / Instructivos (Requerimiento J) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_informacion"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/card_mapa"
            app:layout_constraintBottom_toBottomOf="@id/card_camara"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_camara">

            <LinearLayout
                android:id="@+id/btn_informacion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_informacion_icono"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_instructivos"
                    android:contentDescription="Instructivos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instructivos"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guías de Acción"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:gravity="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Cámara (Requerimientos D, E y F) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_camara"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/card_mapa"
            app:layout_constraintStart_toEndOf="@id/card_informacion"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/btn_camara"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_camara_icono"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="Multimedia" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multimedia"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grabar Alertas"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:gravity="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN DE ACCESOS RÁPIDOS (Fila 2: Linterna y Batería) -->

        <!-- Tarjeta de Linterna (Requerimiento B) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_linterna"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/card_informacion"
            app:layout_constraintBottom_toBottomOf="@id/card_bateria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_bateria">

            <LinearLayout
                android:id="@+id/btn_linterna"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_linterna_estado"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_flashlight"
                    android:contentDescription="Linterna"
                    app:tint="#E65100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Linterna"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp" />

                <!-- TextView dinámico para el estado de la linterna -->
                <TextView
                    android:id="@+id/tv_estado_linterna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APAGADA"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:gravity="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Batería (Requerimiento G) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bateria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/card_camara"
            app:layout_constraintStart_toEndOf="@id/card_linterna"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/btn_bateria"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_bateria_icono"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_battery"
                    android:contentDescription="Batería" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batería"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp" />

                <!-- Porcentaje dinámico de la batería -->
                <TextView
                    android:id="@+id/tv_bateria_nivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#2E7D32"
                    android:gravity="center"
                    android:layout_marginTop="2dp" />

                <!-- Cálculo estimativo de tiempo restante -->
                <TextView
                    android:id="@+id/tv_bateria_estimacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(calculando...)"
                    android:textSize="11sp"
                    android:textColor="#666666"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÓN DE SALIDA DE SEGURIDAD (Cierra y libera recursos de hardware) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_salir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="Salir"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintTop_toBottomOf="@id/card_linterna"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>